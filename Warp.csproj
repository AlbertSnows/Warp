<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Output: bin/Release/Warp.dll
    The build needs Rain World's own libraries, and BepInEx installed in the game.
    -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Warp</AssemblyName>
    <RootNamespace>Warp</RootNamespace>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- C# 12, for file-scoped namespaces, records and primary constructors. This only changes the syntax the compiler
         accepts, not the output. Types that net48 lacks and the new syntax needs are supplied by src/Util/IsExternalInit.cs. -->
    <LangVersion>12</LangVersion>
    <!-- The assembly's own attributes come from these. The version has to match PluginInfo.Version, which a test checks. -->
    <Version>1.9.1</Version>
    <Product>Warp For Meadow</Product>
    <Authors>LeeMoriya, AJ_Snow</Authors>
    <Copyright>Copyright © 2020 LeeMoriya. Changes © 2026 AJ_Snow</Copyright>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Attempting to locate the game. An explicit RainWorldDir wins, then the environment, then the common Steam folders. -->
  <PropertyGroup Condition="'$(RainWorldDir)' == '' and '$(RAINWORLD_DIR)' != ''">
    <RainWorldDir>$(RAINWORLD_DIR)</RainWorldDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RainWorldDir)' == '' and Exists('C:/Program Files (x86)/Steam/steamapps/common/Rain World')">
    <RainWorldDir>C:/Program Files (x86)/Steam/steamapps/common/Rain World</RainWorldDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RainWorldDir)' == '' and Exists('$(HOME)/.local/share/Steam/steamapps/common/Rain World')">
    <RainWorldDir>$(HOME)/.local/share/Steam/steamapps/common/Rain World</RainWorldDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RainWorldDir)' == '' and Exists('$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Rain World')">
    <RainWorldDir>$(HOME)/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Rain World</RainWorldDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RainWorldDir)' == '' and Exists('$(HOME)/Library/Application Support/Steam/steamapps/common/Rain World')">
    <RainWorldDir>$(HOME)/Library/Application Support/Steam/steamapps/common/Rain World</RainWorldDir>
  </PropertyGroup>
  <!-- The original author's own install, kept last so his builds find it as before -->
  <PropertyGroup Condition="'$(RainWorldDir)' == '' and Exists('F:/Steam Games/steamapps/common/Rain World')">
    <RainWorldDir>F:/Steam Games/steamapps/common/Rain World</RainWorldDir>
  </PropertyGroup>

  <Target Name="CheckRainWorldDir" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="'$(RainWorldDir)' == ''
                      or !Exists('$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.dll')
                      or !Exists('$(RainWorldDir)/BepInEx/core/BepInEx.dll')
                      or !Exists('$(RainWorldDir)/BepInEx/plugins/HOOKS-Assembly-CSharp.dll')
                      or !Exists('$(RainWorldDir)/BepInEx/utils/PUBLIC-Assembly-CSharp.dll')"
           Text="Could not find Rain World with BepInEx set up in it. Pass its folder with -p:RainWorldDir=&quot;...&quot; or set RAINWORLD_DIR. The folder needs RainWorld_Data/Managed/UnityEngine.dll, BepInEx/core/BepInEx.dll, and the HOOKS-Assembly-CSharp.dll and PUBLIC-Assembly-CSharp.dll that BepInEx generates the first time the game runs with it. Looked in: '$(RainWorldDir)'" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <!-- A Debug build is written straight into the game's local mods\warp folder, if there is one, so a change can be tried at
       once. This overwrites the Warp in that folder. Pass -p:DeployToGame=false to build into bin/Debug instead. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(DeployToGame)' != 'false' and Exists('$(RainWorldDir)/RainWorld_Data/StreamingAssets/mods/warp')">
    <OutputPath>$(RainWorldDir)/RainWorld_Data/StreamingAssets/mods/warp/newest/plugins/</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin/Release/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the net48 target build on any OS without the .NET Framework developer pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The game's and BepInEx's libraries. Private=false: they are already loaded in the game, never copy them. -->
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(RainWorldDir)/BepInEx/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HOOKS-Assembly-CSharp"><HintPath>$(RainWorldDir)/BepInEx/plugins/HOOKS-Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PUBLIC-Assembly-CSharp"><HintPath>$(RainWorldDir)/BepInEx/utils/PUBLIC-Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The tests are a project of their own, and not part of the plugin -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <!-- Source files are picked up automatically. The default colours are built in, and read with EmbeddedText under the
       name Warp.Resources.Colors.txt. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Colors.txt" />
  </ItemGroup>

  <!--
    Stages the mod as the game and the Workshop expect it, in bin/package/warp-for-meadow:
    modinfo.json (its version filled in from Version above), newest/plugins/Warp.dll, sprites and text. Run it with
    dotnet build Warp.csproj -c Release -t:PackageMod. A thumbnail.png in package/ is included if there is one.
    -->
  <Target Name="PackageMod" DependsOnTargets="Build">
    <PropertyGroup>
      <PackageDir>$(MSBuildProjectDirectory)/bin/package/warp-for-meadow</PackageDir>
      <ModInfoText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/package/modinfo.json').Replace('$VERSION$', '$(Version)'))</ModInfoText>
    </PropertyGroup>
    <ItemGroup>
      <PackageSprite Include="package/sprites/**/*" />
      <PackageText Include="text/**/*" />
      <PackageThumbnail Include="package/thumbnail.png" Condition="Exists('package/thumbnail.png')" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <Copy SourceFiles="$(OutputPath)Warp.dll" DestinationFolder="$(PackageDir)/newest/plugins" />
    <Copy SourceFiles="@(PackageSprite)" DestinationFiles="@(PackageSprite->'$(PackageDir)/sprites/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(PackageText)" DestinationFiles="@(PackageText->'$(PackageDir)/text/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(PackageThumbnail)" DestinationFolder="$(PackageDir)" />
    <WriteLinesToFile File="$(PackageDir)/modinfo.json" Lines="$(ModInfoText)" Overwrite="true" />
    <Message Importance="high" Text="Mod staged in $(PackageDir)" />
  </Target>

</Project>
