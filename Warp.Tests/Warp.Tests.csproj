<Project Sdk="Microsoft.NET.Sdk">

  <!-- Run them with: dotnet run, from this folder. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- So the tests also run where only a newer .NET runtime is installed -->
    <RollForward>Major</RollForward>
    <RootNamespace>Warp.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Tests.cs" />
    <Compile Include="../Switching/SwitchState.cs" />
    <Compile Include="../Switching/SwitchStep.cs" />
    <Compile Include="../Switching/SwitchPolicy.cs" />
  </ItemGroup>

</Project>
